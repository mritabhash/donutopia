{
  "name": "donutopia-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "ai": {"binding": "AI"},
  "vars": {"ALLOWED_ORIGIN": "https://mritabhash.github.io"},
